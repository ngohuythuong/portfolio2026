---
import BaseLayout from "../layouts/BaseLayout.astro";
import CustomImage from "../components/CustomImage.astro";
import Icon from "../components/Icon.astro";
import Lines from "../components/Lines.astro";
import { getEntry } from "astro:content";

const { data: page } = await getEntry("about", "index");
const { hero, perspective, intent, skills, human_side } = page;
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <section
    class="hero"
    data-pin-container
    data-pin-media="all"
    data-pin-mode="backward"
    data-pin-start="top top"
  >
    <div class="hero-wrapper" data-pin-element>
      <div class="container container--flush">
        <h1 class="marquee" aria-label={`${hero.heading_accent} ${hero.heading}`}>
          <span class="marquee__track">
            <span class="text-h1 text-h1--xl">
              <span class="custom-font">{hero.heading_accent}</span>{hero.heading} -
            </span>
          </span>
        </h1>
      </div>
      <div class="container align-center">
        <div
          class="media-frame"
          data-img-anim="hero-block"
          data-settings='{"type": "down", "duration": 1.5, "delay": 0.1,  "repeat": true}'
        >
          <CustomImage
            src={hero.image.src}
            alt={hero.image.alt}
            importance="feature"
          />
        </div>
        <span
          class="scroll-hint"
          data-split-text-anim="word"
          data-settings='{ "repeat": true}'>{hero.scroll_hint}</span
        >
      </div>
    </div>
  </section>
  <section
    class="intro"
    data-pin-container
    data-pin-media="all"
    data-pin-start="top 0%"
    data-pin-end="bottom top"
  >
    <div class="container align-center" data-pin-element>
      <p
        class="p-big"
        data-split-text-anim="line"
        data-settings='{ "repeat": true}'
      >
        {page.intro}
      </p>
    </div>
  </section>
  <section class="perspective">
    <div class="container align-center">
      <div class="perspective__layout">
        <div
          class="media-frame"
          data-img-anim="block"
          data-settings='{"type": "down",  "duration": 1.5, "repeat": true}'
        >
          <CustomImage
            src={perspective.image.src}
            alt={perspective.image.alt}
            importance="feature"
            class="perspective-image"
          />
        </div>
        <div class="perspective__content">
          <div class="section-header">
            <div
              class="overline"
              data-scroll-anim="slide-up"
              data-settings='{ "repeat": true}'
            >
              <Icon name="add" />
              <span class="overline__text">{perspective.overline}</span>
            </div>
            <h2
              class="text-h2"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              <Lines text={perspective.heading} />
            </h2>
          </div>
          <div class="perspective__text">
            {
              perspective.paragraphs.map((paragraph) => (
                <p
                  class="p-md"
                  data-split-text-anim="linesMask"
                  data-settings='{"fgColor": "#191919", "repeat": true, "scrub": true}'
                >
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <section
    class="intent"
    data-pin-container
    data-pin-media="all"
    data-pin-start="top top"
    data-pin-end="bottom bottom"
    data-pin-space="true"
  >
    <div class="section--bg-video" data-pin-element>
      <div class="bg-filter"></div>
      <div
        class="media-embed"
        data-controls="false"
        data-autoplay="true"
        data-muted="true"
        data-loop="true"
      >
        <video
          autoplay
          muted
          playsinline
          loop
          class="media-embed__video"
          poster={intent.video.poster}
        >
          <source src={intent.video.src} type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="intent__text-content" data-pin-end-trigger>
      <div class="container container--md">
        <div class="section-header">
          <div
            class="overline"
            data-scroll-anim="slide-up"
            data-settings='{ "repeat": true}'
          >
            <Icon name="add" />
            <span class="overline__text">{intent.overline}</span>
          </div>
          <h2
            class="text-h2"
            data-split-text-anim="line"
            data-settings='{ "repeat": true}'
          >
            <Lines text={intent.heading} />
          </h2>
        </div>
        {
          intent.paragraphs.map((paragraph, index) => (
            <div
              class:list={[
                "intent__row",
                index === 0 ? "intent__row--right" : "intent__row--center",
              ]}
            >
              <p
                class="p-md"
                data-split-text-anim="linesMask"
                data-settings='{"bgColor": "rgba(255,255,255,0.32)", "fgColor": "#ffffff", "repeat": true, "scrub": true}'
              >
                {paragraph}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="skills">
    <div class="container">
      <div class="skills__row">
        <div class="skills__aside">
          <div class="section-header">
            <div
              class="overline"
              data-scroll-anim="slide-up"
              data-settings='{ "repeat": true}'
            >
              <Icon name="add" />
              <span class="overline__text">{skills.overline}</span>
            </div>
            <h2
              class="text-h2"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              <Lines text={skills.heading} />
            </h2>
            <p
              class="p-desc"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              {skills.description}
            </p>
          </div>
          <div class="personal">
            <div class="media-frame">
              <CustomImage src={skills.image.src} alt={skills.image.alt} importance="detail" />
            </div>
            <div class="chat-bubble">
              <span id="typing-text" data-words={JSON.stringify(skills.typing_words)}></span><span class="cursor"></span>
            </div>
          </div>
        </div>
        <div class="skills__list">
          {
            skills.items.map((item) => (
              <div class="skills__item">
                <h3 class="text-h3" data-split-text-anim="line">{item.title}</h3>
                <p class="p-md">{item.text}</p>
                <ul class="tools">
                  {item.tags.map((tag) => <li class="tools-badges">{tag}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="human-side">
    <div class="container">
      <div class="human-side__row">
        <div class="human-side__content">
          <div class="section-header">
            <div
              class="overline"
              data-scroll-anim="slide-up"
              data-settings='{ "repeat": true}'
            >
              <Icon name="add" />
              <span class="overline__text">{human_side.overline}</span>
            </div>
            <h2
              class="text-h2"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              <Lines text={human_side.heading} />
            </h2>
          </div>
          <p
            class="human-side__desc"
            data-split-text-anim="line"
            data-settings='{ "repeat": true}'
          >
            {human_side.description}
          </p>
        </div>
        <div class="funfact-list">
          {
            human_side.funfacts.map((funfact) => (
              <div class="funfact-card" data-stack-card data-rotate={funfact.rotate}>
                <div class="media-frame">
                  <CustomImage
                    src={funfact.image.src}
                    alt={funfact.image.alt}
                    importance="detail"
                    class="funfact-image"
                  />
                </div>
                <div class="funfact-card__body">
                  <h3 class="text-h3" data-split-text-anim="line">{funfact.title}</h3>
                  <p class="p-md">{funfact.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding-top: 12rem;
      min-height: 100vh;
    }

    .hero-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 3rem;
      align-items: center;
    }

    .hero .media-frame {
      width: 240px;
      aspect-ratio: 4/5;
      img {
        filter: grayscale(100%) contrast(1);
      }
    }

    .intro {
      background-color: var(--darkBackground);
      min-height: 100vh;
      padding: 12rem 0;

      .p-big {
        max-width: 720px;
        text-align: center;
        color: var(--lightText);
      }
    }

    .scroll-hint {
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 1rem;
    }

    .perspective__text {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .perspective {
      padding: 6rem 0;
      background-color: var(--mainBackground);
    }

    .perspective__layout {
      width: 25%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4rem;
    }

    .perspective__content {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
    }

    .intent {
      padding-top: 6rem;
      min-height: 100vh;
    }

    .intent__text-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 1;
      margin-top: 40vh;
      padding-bottom: 40vh;
      color: #ffffff;

      .text-h2 {
        max-width: 480px;
      }
    }

    .intent__row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .intent__row--center {
      justify-content: center;
    }

    .intent__row--right {
      justify-content: flex-end;
    }

    .intent .p-md {
      width: 30%;
      margin-top: 6rem;
    }

    .section--bg-video {
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
    }

    .skills {
      padding: 6rem 0;
    }

    .skills__row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .skills__aside {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 6rem;
      flex: 1;
    }

    .skills__aside .section-header {
      max-width: 520px;
      width: 100%;
    }

    .skills__aside .personal {
      width: 110px;
      position: relative;
      display: inline-block;
    }

    .skills__list {
      width: 40%;
    }

    .skills__item {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 3rem 0;
      border-top: 1px solid var(--linesColor);
    }

    .chat-bubble {
      position: absolute;
      top: 0;
      left: 104px;
      background-color: #ffffff;
      color: var(--mainColor);
      padding: 0.75rem 1rem;
      border-radius: 1rem;
      border-bottom-left-radius: 2px;
      font-size: 1rem;
      display: flex;
      align-items: center;
      font-weight: 400;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      white-space: nowrap;
    }
    /* Con trỏ nhấp nháy */
    .cursor {
      display: inline-block;
      width: 3px;
      height: 20px;
      margin-left: 4px;
      background-color: #f35f09;
      animation: blink 0.7s infinite;
    }
    @keyframes blink {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    .human-side {
      padding: 10rem 0 6rem 0;
      min-height: 300vh;
      overflow: visible;
    }

    .human-side__row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      align-items: center;
      min-height: 100%;
    }

    .human-side__content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4rem;
    }

    .human-side__content .section-header {
      max-width: 520px;
      width: 100%;
    }

    .human-side__desc {
      font-size: 1.5rem;
      line-height: 1.4;
      max-width: 560px;
    }

    .funfact-list {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
    }

    .funfact-card {
      display: flex;
      flex-direction: column;
      width: 432px;
      max-width: 100%;
      background-color: var(--secondaryBackground);
    }

    @media (min-width: 992px) {
      .funfact-list {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr;
        justify-items: center;
        align-items: center;
      }
      .funfact-card {
        grid-row: 1;
        grid-column: 1;
        will-change: transform;
      }
    }

    .funfact-card .media-frame {
      width: 100%;
      height: auto;
      aspect-ratio: 1/1;
      padding: 1rem 1rem 0 1rem;
      overflow: hidden;
    }

    .funfact-card__body {
      padding: 1rem 1.5rem 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
      text-align: center;
    }

    @media only screen and (max-width: 767px) {
      .hero {
        padding-top: 10rem;
      }
      .perspective,
      .human-side,
      .skills {
        padding: 3rem 0;
      }

      .scroll-hint {
        order: 2;
      }

      .perspective__layout {
        width: 100%;
        gap: 3rem;
      }

      .intent .p-md {
        width: 100%;
        margin-top: 2rem;
      }

      .skills__list,
      .human-side__content,
      .funfact-list,
      .funfact-card {
        width: 100%;
      }
    }

    @media (min-width: 768px) and (max-width: 1023px) {
      .perspective,
      .human-side,
      .skills {
        padding: 4rem 0;
      }

      .perspective__layout {
        width: 60%;
        gap: 3rem;
      }

      .intent .p-md {
        width: 50%;
        margin-top: 4rem;
      }

      .skills__list,
      .human-side__content,
      .funfact-list,
      .funfact-card {
        width: 100%;
      }
    }

    @media (min-width: 1024px) and (max-width: 1440px) {
      .perspective__layout {
        width: 40%;
      }
    }
  </style>
  <script>
    const typingTarget = document.getElementById("typing-text");

    // Danh sách các từ chạy hiệu ứng — khai báo ở skills.typing_words trong src/content/about/index.yaml
    const words: string[] = JSON.parse(typingTarget?.dataset.words ?? "[]");

    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function typeEffect() {
      const currentWord = words[wordIndex];

      if (isDeleting) {
        // Trừ bớt 1 ký tự khi đang xóa
        charIndex--;
      } else {
        // Thêm 1 ký tự khi đang gõ
        charIndex++;
      }

      // Hiển thị đoạn chữ cắt lớp ra màn hình
      if (typingTarget) {
        typingTarget.textContent = currentWord.substring(0, charIndex);
      }

      // Tốc độ mặc định khi gõ chữ (ms)
      let typeSpeed = 100;

      // Nếu đang xóa thì tăng tốc độ lên cho mượt hơn
      if (isDeleting) {
        typeSpeed /= 2;
      }

      // Nếu đã gõ xong trọn vẹn từ
      if (!isDeleting && charIndex === currentWord.length) {
        typeSpeed = 1500; // Dừng lại 1.5 giây để người dùng đọc chữ
        isDeleting = true;
      }
      // Nếu đã xóa hết chữ của từ đó
      else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length; // Chuyển sang từ tiếp theo, hết mảng thì quay lại từ đầu
        typeSpeed = 300; // Nghỉ một chút trước khi bắt đầu gõ từ mới
      }

      setTimeout(typeEffect, typeSpeed);
    }

    // Chạy hiệu ứng ngay khi DOM đã sẵn sàng
    document.addEventListener("DOMContentLoaded", () => {
      // Đợi 500ms ban đầu rồi mới kích hoạt hiệu ứng gõ
      if (words.length) setTimeout(typeEffect, 500);
    });
  </script>
</BaseLayout>
