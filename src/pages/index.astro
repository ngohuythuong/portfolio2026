---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection, getEntry } from "astro:content";
import CustomImage from "../components/CustomImage.astro";
import Icon from "../components/Icon.astro";
import Lines from "../components/Lines.astro";

const { data: page } = await getEntry("home", "index");
const { hero, intro_video, mindset, process, works: worksSection, behind } = page;

const allWorks = await getCollection("works");
const works = [...allWorks]
  .sort((a, b) =>
    a.data.project_hero.metadata.stt.localeCompare(
      b.data.project_hero.metadata.stt,
    ),
  )
  .slice(0, worksSection.limit);

const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <section
    class="hero"
    data-pin-container
    data-pin-media="desktop"
    data-pin-mode="backward"
    data-pin-start="top top"
  >
    <div class="container" data-pin-element>
      <div class="hero__content">
        <div class="hero__text">
          <h1
            class="text-h1"
            data-split-text-anim="word"
            data-settings='{ "repeat": true}'
          >
            {hero.heading}
          </h1>
        </div>
        <div
          class="media-frame"
          data-img-anim="hero-block"
          data-settings='{"type": "down", "duration": 1.5, "delay": 0.1,  "repeat": true}'
        >
          <CustomImage src={hero.image.src} alt={hero.image.alt} importance="feature" />
        </div>
        <div
          class="hero__text"
          data-split-text-anim="word"
          data-settings='{ "repeat": true}'
        >
          <span data-split-text-anim="word" data-settings='{ "repeat": true}'
            >{hero.caption}</span
          >
        </div>
      </div>
    </div>
  </section>
  <section
    class="intro-video-section"
    data-parallax-container
    data-parallax-media="all"
    data-parallax-start="top bottom"
    data-parallax-end="bottom top"
    data-parallax-y="-30"
  >
    <div class="section--bg-video" data-parallax-element>
      <div
        class="media-embed"
        data-controls="false"
        data-autoplay="true"
        data-muted="true"
        data-loop="true"
      >
        <video
          autoplay
          muted
          playsinline
          loop
          class="media-embed__video"
          poster={intro_video.poster}
        >
          <source src={intro_video.src} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
  <section class="mindset">
    <div class="container container--lg">
      <div class="row">
        <div class="col l-4 m-4 s-12">
          <div
            class="overline"
            data-split-text-anim="line"
            data-settings='{ "repeat": true}'
          >
            <Icon name="add" />
            <span class="overline__text">{mindset.overline}</span>
          </div>
        </div>
        <div class="col l-6 m-8 s-12">
          <div class="hero__text">
            <p
              class="p-big"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              {mindset.text}
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="container container--lg">
      <div
        class="mindset__grid"
        data-scroll-anim="slide-up"
        data-settings='{ "repeat": true}'
        data-scroll-stagger
      >
        {
          mindset.cards.map((card, index) => (
            <div class:list={["mindset-card", { "mindset-card--dark": card.dark }]}>
              <span class="mindset-card__number">{pad(index)}</span>
              <div class="mindset-card__body">
                <h3 class="text-h3"><Lines text={card.title} /></h3>
                <p class="p-md">{card.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="process">
    <div class="container">
      <div class="section-header">
        <div
          class="overline"
          data-split-text-anim="line"
              data-settings='{ "repeat": true}'
        >
          <Icon name="add" />
          <span class="overline__text">{process.overline}</span>
        </div>
        <h2
          class="text-h2"
          data-split-text-anim="line"
          data-settings='{ "repeat": false}'
        >
          {process.heading}
        </h2>
        <p
          class="p-desc"
          data-split-text-anim="line"
          data-settings='{ "repeat": true}'
        >
          {process.description}
        </p>
      </div>
    </div>
    <div class="container">
      <ul
        class="process__list"
      >
        {
          process.steps.map((step, index) => (
            <li class="process__item">
              <span class="process__item-number">{pad(index)}</span>
              <div class="process__item-title">
                <h3 class="text-h3" data-split-text-anim="line" data-settings='{ "repeat": true}'>{step.title}</h3>
                <p class="p-desc" data-split-text-anim="line" data-settings='{ "repeat": true}'>{step.subtitle}</p>
              </div>
              <div class="process__item-body">
                <p class="p-md" data-split-text-anim="line" data-settings='{ "repeat": true}'>
                  {step.text}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="case-study">
    <div class="container container--lg">
      <div
        class="case-study__wrapper"
        data-pin-container
        data-pin-media="desktop"
        data-pin-start="top 20%"
        data-pin-end="bottom center"
      >
        <div class="case-study__header-wrap" data-pin-element>
          <div class="section-header">
            <div class="overline">
              <Icon name="add" />
              <span
                class="overline__text"
                data-split-text-anim="word"
                data-settings='{ "repeat": true}'>{worksSection.overline}</span
              >
            </div>
            <h2
              class="text-h2"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              {worksSection.heading}
            </h2>
            <p
              class="p-desc"
              data-split-text-anim="line"
              data-settings='{ "repeat": true}'
            >
              {worksSection.description}
            </p>
          </div>
          <div
            class="btn-container"
            data-scroll-anim="slide-up"
            data-settings='{ "repeat": true}'
          >
            <a href={worksSection.cta.href} class="btn-link" data-hover>
              <span>{worksSection.cta.label}</span>
              <Icon name="arrow_outward" />
            </a>
          </div>
        </div>
        <div class="case-study__list">
          {works.map((work) => <ProjectCard project={work} variant="box" />)}
        </div>
      </div>
    </div>
  </section>
  <section class="behind">
    <div class="container container--lg">
      <div class="behind__wrapper">
        <div class="behind__video">
          <div
            class="media-embed"
            data-controls="false"
            data-autoplay="true"
            data-muted="true"
            data-loop="true"
            data-img-anim="block"
            data-settings='{"type": "down", "delay": 0.2, "duration": 1.5, "repeat": true}'
          >
            <video
              autoplay
              muted
              playsinline
              loop
              class="media-embed__video"
              poster={behind.video.poster}
            >
              <source src={behind.video.src} type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="behind__text">
          <div
            class="overline"
           data-split-text-anim="line" data-settings='{ "repeat": true}'
          >
            <Icon name="add" />
            <span class="overline__text">{behind.overline}</span>
          </div>
          <p
            class="p-big"
            data-split-text-anim="line"
            data-settings='{ "repeat": true}'
          >
            {behind.text}
          </p>
          <div
            class="btn-container"
            data-scroll-anim="slide-up"
            data-settings='{ "repeat": true}'
          >
            <a href={behind.cta.href} class="btn-link" data-hover>
              <span>{behind.cta.label}</span>
              <Icon name="arrow_outward" />
            </a>
          </div>
        </div>
        <div
          class="media-frame behind__photo"
          data-img-anim="block"
          data-settings='{"type": "down",  "duration": 1.5, "repeat": true}'
        >
          <CustomImage
            src={behind.image.src}
            alt={behind.image.alt}
            importance="detail"
            class="human-img"
          />
        </div>
      </div>
    </div>
    <div class="container container--flush">
      <div class="marquee">
        <div class="marquee__track">
          <span class="text-h1">{behind.marquee}</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 12rem;
    min-height: 100vh;

    h1 {
      text-transform: uppercase;
      text-align: center;
      max-width: 740px;
    }

    .media-frame {
      width: 280px;
      aspect-ratio: 4/5;
    }

    .hero__content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }
  }

  .intro-video-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    z-index: 10;
    .section--bg-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      /* Parallax dịch -30% chiều cao khung → cần ≥ 100vh / 0.7 ≈ 143vh để không hở đáy section */
      height: 145vh;
      will-change: transform;
    }
  }

  .mindset,
  .case-study {
    padding: 6rem 0 8rem 0;
    background-color: var(--mainBackground);
  }

  .mindset .overline {
    margin-bottom: 1.5rem;
  }

  .process {
    padding: 6rem 0;
    gap: 6rem;
    background-color: var(--secondaryBackground);
  }

  .behind {
    padding: 12rem 0 3rem 0;
  }

  .behind__wrapper {
    display: flex;
    flex-direction: row;
    gap: 3rem 1.5rem;
    flex-wrap: wrap;
  }

  .behind__video {
    width: 25%;
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
  }

  .behind__photo {
    width: 25%;
    flex-shrink: 0;
    margin-bottom: 4rem;
    aspect-ratio: 4/5;
  }

  .behind__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
    padding: 0 2rem;
  }

  .process__item {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    padding: 5rem 0;
    border-top: 1px solid var(--linesColor);
    gap: 1.5rem;
  }

  .process__item-number {
    width: 20%;
  }

  .process__item-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .process__item-body {
    width: 30%;
  }

  .case-study__header-wrap {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    flex: 1;
  }

  .case-study__wrapper {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
  }

  .case-study .section-header {
    max-width: 480px;
    width: 100%;
  }

  .case-study__list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* ProjectCard là component con → cần :global để style scoped chạm được tới */
  .case-study__list :global(.project-card__thumb img) {
    filter: none;
  }

  .mindset-card {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding: 1.5rem;
    background-color: var(--secondaryBackground);
    min-height: 400px;
  }

  .mindset-card--dark {
    background-color: var(--darkBackground);
    color: var(--lightText);
  }

  .mindset-card__number {
    text-transform: uppercase;
    letter-spacing: 0.08rem;
    color: var(--secondaryColor);
  }

  .mindset-card__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mindset__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /*----responsive----*/
  @media screen and (max-width: 767px) {
    .hero {
      padding-top: 10rem;
      padding-bottom: 4rem;

      h1 {
        text-align: left;
      }

      .media-frame {
        width: 100%;
      }
    }

    .case-study__wrapper {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .behind__text {
      width: 100%;
      padding: 0;
    }

    .behind__photo {
      width: 100%;
      margin-bottom: 0;
    }

    .mindset,
    .process,
    .case-study,
    .behind {
      padding: 3rem 0;
    }

    .mindset__grid {
      grid-template-columns: repeat(1, 1fr);
    }

    .process__item {
      padding: 3rem 0;
    }

    .process__item-number,
    .process__item-body {
      width: 100%;
    }

    .case-study__list {
      width: 100%;
      gap: 2rem;
    }

    .case-study__header-wrap,
    .case-study .section-header,
    .behind__video {
      width: 100%;
    }
  }
</style>
