---
import BaseLayout from "../layouts/BaseLayout.astro";
import CustomImage from "../components/CustomImage.astro";
import { getEntry } from "astro:content";

const { data: page } = await getEntry("contact", "index");
const { data: site } = await getEntry("site", "index");
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  hideFooter={true}
>
  <section class="contact">
    <div class="container">
      <div class="section-header">
        <span
          class="sub-title"
          data-split-text-anim="word"
          data-settings='{ "repeat": true}'>{page.subtitle}</span
        >
        <h1
          class="text-h1 text-h1--md"
          data-split-text-anim="word"
          data-settings='{ "repeat": true}'
        >
          {page.heading}
        </h1>
      </div>
    </div>

    <div class="container">
      <div class="contact__layout">
        <div class="contact__info">
          <div class="contact__grid">
            <div class="contact-item">
              <span class="contact__item-label">{page.labels.email}</span>
              <div class="btn-text">
                <a class="btn-link md" data-hover href={`mailto:${site.email}`}
                  >{site.email}</a
                >
              </div>
            </div>
            <div class="contact-item">
              <span class="contact__item-label">{page.labels.socials}</span>
              <div class="contact__social">
                {
                  site.socials.map((social) => (
                    <div class="btn-text">
                      <a class="btn-link md" data-hover href={social.href}>
                        {social.label}
                      </a>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="contact-item">
              <span class="contact__item-label">{page.labels.availability}</span>
              <span class="contact__item-value">{page.availability}</span>
            </div>
            <div class="contact-item">
              <span class="contact__item-label">{page.labels.location}</span>
              <div class="clock">
                <span>{page.clock_label}</span>
                <span class="clock__display">00:00:00</span>
              </div>
            </div>
          </div>
        </div>
        <div
          class="media-frame contact__photo"
          data-img-anim="hero-block"
          data-settings='{"type": "down", "duration": 1.5, "delay": 0.1,  "repeat": true}'
        >
          <CustomImage src={page.image.src} alt={page.image.alt} importance="feature" />
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact {
      padding-top: 12rem;
      padding-bottom: 4rem;
      min-height: 100vh;
      align-items: start;
      justify-content: space-between;
    }

    .contact__layout {
      display: flex;
      flex-direction: row;
      align-items: end;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .contact__info {
      width: 50%;
    }

    .contact__grid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .contact-item {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .contact__item-label {
      color: var(--secondaryColor);
    }

    .contact__photo {
      width: 320px;
    }

    .contact__social {
      display: flex;
      gap: 1rem;
    }

    @media screen and (max-width: 767px) {
      .contact__info {
        width: 100%;
      }
      .contact__photo {
        width: 100%;
      }

      .contact__grid {
        grid-template-columns: repeat(1, 1fr);
        gap: 1.5rem;
      }

      .contact {
        padding-top: 10rem;
        padding-bottom: 3rem;
      }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
      .contact__grid {
        grid-template-columns: repeat(1, 1fr);
        gap: 1.5rem;
      }
    }
  </style>
</BaseLayout>
