---
import CustomImage from "./CustomImage.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"works">;
}

const { project } = Astro.props;
---

<a href={`/works/${project.slug}`} class="next-project" data-hover-group>
  <div class="next-project__content">
    <span class="overline__text">Next Project</span>
    <h2 class="next-project__title text-h1" data-hover data-split-text-anim="line">
      {project.data.project_hero.title}
    </h2>
    <span class="p-md">{project.data.project_hero.metadata.category}</span>
  </div>
  <div class="next-project__bg">
    {
      project.data.project_hero.thumbnail.image && (
        <CustomImage
          src={project.data.project_hero.thumbnail.image}
          alt={project.data.project_hero.title}
          importance="hero"
        />
      )
    }
    <div class="next-project__overlay"></div>
  </div>
</a>

<style>
  .next-project {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 6rem 2rem;
    text-align: center;
    overflow: hidden;
    color: #ffffff;
    text-decoration: none;
    width: 100%;
    min-height: 100vh;
  }

  .next-project__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .next-project__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .next-project__overlay {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: 0.4;
    z-index: 2;
  }

  .next-project__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .next-project {
      min-height: 60vh;
    }
  }
</style>
